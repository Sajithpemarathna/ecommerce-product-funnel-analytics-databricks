      ]
    },
    {
      "name": "1f6e0be0",
      "displayName": "ds_pipeline_monitoring",
      "queryLines": [
        "SELECT\r\n",
        "  run_date,\r\n",
        "  layer,\r\n",
        "  target_table,\r\n",
        "  status,\r\n",
        "  message,\r\n",
        "  logged_at\r\n",
        "FROM workspace.default.pipeline_monitoring\r\n",
        "ORDER BY logged_at DESC\r\n"
      ]
    }
