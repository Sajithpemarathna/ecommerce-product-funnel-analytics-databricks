{
  "datasets": [
    {
      "name": "c15d33eb",
      "displayName": "ds_daily_funnel",
      "queryLines": [
        "SELECT\r\n",
        "  event_date,\r\n",
        "  views,\r\n",
        "  carts,\r\n",
        "  purchases\r\n",
        "FROM workspace.default.vw_daily_funnel\r\n",
        "ORDER BY event_date;\r\n"
      ]
    },
    {
      "name": "ce692fad",
      "displayName": "ds_daily_conversion_rates",
      "queryLines": [
        "SELECT\r\n",
        "  event_date,\r\n",
        "  view_to_purchase_rate,\r\n",
        "  session_to_purchase_rate\r\n",
        "FROM workspace.default.vw_daily_funnel\r\n",
        "ORDER BY event_date;\r\n"
      ]
    },
    {
      "name": "b7f86ef8",
      "displayName": "ds_product_daily",
      "queryLines": [
        "SELECT\r\n",
        "  event_date,\r\n",
        "  product_id,\r\n",
        "  revenue,\r\n",
        "  views,\r\n",
        "  purchases,\r\n",
        "  product_conversion_rate\r\n",
        "FROM workspace.default.vw_product_daily;\r\n"
      ]
    },
    {
      "name": "b8e5bbad",
      "displayName": "ds_pipeline_state",
      "queryLines": [
        "SELECT\r\n",
        "  pipeline_name,\r\n",
        "  last_released_date,\r\n",
        "  updated_at\r\n",
        "FROM monitoring.pipeline_state\r\n",
        "ORDER BY updated_at DESC;\r\n"
      ]
    },
    {
      "name": "ec8e5349",
      "displayName": "vw_overall_kpis",
      "queryLines": [
        "SELECT * FROM workspace.default.vw_overall_kpis"
      ]
    },
    {
      "name": "3dc57f8f",
