   "source": [
    "CREATE OR REPLACE VIEW workspace.default.vw_product_daily AS\n",
    "SELECT\n",
    "  event_date,\n",
    "  product_id,\n",
    "  views,\n",
    "  carts,\n",
    "  purchases,\n",
    "  revenue,\n",
    "  ROUND(purchases / NULLIF(views, 0), 4) AS product_conversion_rate\n",
    "FROM workspace.default.gold_product_daily_metrics;\n"
   ]
  }
 ],
